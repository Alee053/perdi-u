{
  "name": "perdi-u",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @perdiu/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:build && node scripts/run-tdd.mjs",
    "test:integration": "node scripts/verify-catalog.mjs",
    "test:e2e": "node scripts/verify-catalog.mjs --with-browser",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@perdiu/database",
    "db:seed": "turbo run db:seed --filter=@perdiu/database",
    "preview": "pnpm --filter @perdiu/web preview",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:repo": "jest --testPathPattern=scripts/test/",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "pnpm format:check && pnpm check:docs && pnpm check:boundaries && pnpm typecheck && pnpm test:unit && pnpm build",
    "prepare": "husky",
    "test:build": "turbo run build --filter=@perdiu/api",
    "test:unit": "pnpm test:build && jest",
    "semantic-commits-on": "node semantic-commits.js enable",
    "semantic-commits-off": "node semantic-commits.js disabled"
  },
  "devDependencies": {
    "@perdiu/database": "workspace:*",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.7",
    "@babel/core": "^7.25.2",
    "@babel/preset-typescript": "^7.25.9",
    "@jest/globals": "29.7.0",
    "babel-jest": "29.7.0",
    "cross-spawn": "^7.0.3",
    "husky": "^9.1.6",
    "jest": "29.7.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "type": "module",
  "description": "PerdiU con seguimiento TDD de TDDLabBaseProject"
}
