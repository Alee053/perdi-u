# Fresh hex secrets for this disposable demo only; never reuse the local .env.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=
AUTH_JWT_KEYS=
AUTH_SITE_URL=https://perdi-u-chi.vercel.app
# Disposable demo only: accept signup immediately without confirming the mailbox.
AUTH_MAILER_AUTOCONFIRM=true
MAILPIT_PORT=18025
PROXY_NETWORK=proxy-net

# Only when the deploy files are copied to /opt/stacks/perdi-u, beside repo/:
