{
  "name": "@perdiu/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include '../../packages/catalog/dist/**/*.js' --include '../../packages/database/dist/**/*.js' --include '../../packages/contracts/dist/**/*.js' src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "pnpm --workspace-root exec jest --testPathPattern=apps/api/test/",
    "test:integration": "pnpm --workspace-root exec jest --config jest.integration.config.cjs --runInBand --runTestsByPath apps/api/test/catalog.integration.ts apps/api/test/report-detail.integration.ts apps/api/test/auth.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@perdiu/catalog": "workspace:*",
    "@perdiu/contracts": "workspace:*",
    "@perdiu/database": "workspace:*",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
