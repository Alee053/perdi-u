# Local development only. Choose a password; URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
# DATABASE_URL format: postgresql://perdiu:<password>@127.0.0.1:5433/perdiu_dev
# Optional: host port for PostgreSQL (default 5433); keep DATABASE_URL in sync.
# POSTGRES_PORT=5433
PORT=3000
HOST=127.0.0.1

# Supabase Auth (GoTrue) in Compose. Generate the three secrets with `pnpm auth:keys`.
# AUTH_JWT_KEYS holds the ES256 private signing key: keep it in Auth only, never in VITE_*.
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=
AUTH_JWT_KEYS=
# Public URLs seen by the browser (Vite proxies /auth to 127.0.0.1:9999).
AUTH_SITE_URL=http://localhost:5173
AUTH_PUBLIC_URL=http://localhost:5173/auth
# false: new accounts confirm their e-mail through the link captured by Mailpit (127.0.0.1:8025).
AUTH_MAILER_AUTOCONFIRM=false

# API: verifies access tokens with Auth's public keys; it never receives the private key.
AUTH_JWKS_URL=http://127.0.0.1:9999/.well-known/jwks.json
AUTH_JWT_ISSUER=http://localhost:5173/auth

# Opcional: bucket R2 privado autorizado para fotos. Mantener estas variables solo en el .env local.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
