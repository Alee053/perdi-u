{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_BASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "PORT", "HOST", "API_PROXY_TARGET", "VITE_API_BASE_URL"]
    },
    "test:integration": {
      "dependsOn": ["build", "^test:integration"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "PERDIU_TEST_CONTAINER", "NODE_ENV"]
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    }
  }
}
